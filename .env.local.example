#.env

#############
## App config
#############
NODE_ENV=development
### Analytics (optional; defaults to the measurement ID in lib/config.ts)
### Must keep the NEXT_PUBLIC_ prefix so Next.js inlines it at build time
NEXT_PUBLIC_GOOGLE_ANALYTICS_KEY=
### The Plasmic project ID and API token for UI
PLASMIC_PROJECT_ID=
PLASMIC_PROJECT_API_TOKEN=
